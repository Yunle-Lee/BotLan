<Window x:Class="IslandUI.AgentConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IslandUI"
        xmlns:bots="clr-namespace:IslandUI.Bots"
        Title="添加 Agent" Width="380" Height="530"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <Style x:Key="ComicInput" TargetType="TextBox">
            <Setter Property="Background" Value="{Binding Card, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="Foreground" Value="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="BorderBrush" Value="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="BorderThickness" Value="1.6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ComicPassword" TargetType="PasswordBox">
            <Setter Property="Background" Value="{Binding Card, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="Foreground" Value="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="BorderBrush" Value="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="BorderThickness" Value="1.6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16,18,16,14"
            Background="{Binding Canvas, Source={x:Static local:ComicTheme.Current}}"
            BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"
            BorderThickness="2.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="22">
            <Grid Margin="0,0,0,6">
                <TextBlock Text="添加 Agent" FontFamily="Comic Sans MS" FontSize="16" FontWeight="Bold"
                           Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
                <TextBlock Text="&#x2715;" FontFamily="Comic Sans MS" FontSize="13" Cursor="Hand"
                           HorizontalAlignment="Right"
                           Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                           MouseLeftButtonUp="Close_Click"/>
            </Grid>

            <TextBlock Text="名字" FontFamily="Comic Sans MS" FontSize="11"
                       Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource ComicInput}" Text="Agent"/>

            <TextBlock Text="API 地址（OpenAI 兼容）" FontFamily="Comic Sans MS" FontSize="11" Margin="0,8,0,0"
                       Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
            <TextBox x:Name="BaseUrlBox" Style="{StaticResource ComicInput}" Text="https://api.moonshot.cn/v1"/>

            <TextBlock Text="模型" FontFamily="Comic Sans MS" FontSize="11" Margin="0,8,0,0"
                       Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
            <TextBox x:Name="ModelBox" Style="{StaticResource ComicInput}" Text="kimi-k2"/>

            <TextBlock Text="API Key" FontFamily="Comic Sans MS" FontSize="11" Margin="0,8,0,0"
                       Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
            <PasswordBox x:Name="KeyBox" Style="{StaticResource ComicPassword}"/>

            <TextBlock Text="圆环颜色" FontFamily="Comic Sans MS" FontSize="11" Margin="0,10,0,4"
                       Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
            <StackPanel x:Name="ColorRow" Orientation="Horizontal"/>

            <TextBlock Text="圆环显示" FontFamily="Comic Sans MS" FontSize="11" Margin="0,10,0,4"
                       Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RingStatus" Content="工作状态" GroupName="ring"
                             FontFamily="Comic Sans MS" FontSize="12" IsChecked="True"
                             Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
                <RadioButton x:Name="RingQuota" Content="API 剩余量" GroupName="ring"
                             FontFamily="Comic Sans MS" FontSize="12" Margin="14,0,0,0"
                             Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="自定义外观" Click="Customize_Click"
                        Padding="12,6" Cursor="Hand" FontFamily="Comic Sans MS"/>
                <Border x:Name="PreviewDot" Width="30" Height="30" CornerRadius="15"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"
                        BorderThickness="1.6">
                    <bots:BotView x:Name="Preview" Margin="3"/>
                </Border>
            </StackPanel>

            <Button Content="启动 Agent" Click="Add_Click" Margin="0,18,0,0"
                    Padding="14,8" HorizontalAlignment="Left" Cursor="Hand"
                    FontFamily="Comic Sans MS"/>
        </StackPanel>
    </Border>
</Window>
