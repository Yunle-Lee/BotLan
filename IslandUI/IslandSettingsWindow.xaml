<Window x:Class="IslandUI.IslandSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IslandUI"
        Title="小岛设置" Width="320" Height="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <Style x:Key="ComicCheck" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Foreground" Value="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
        </Style>
        <Style x:Key="ComicRadio" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16,18,16,14"
            Background="{Binding Canvas, Source={x:Static local:ComicTheme.Current}}"
            BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"
            BorderThickness="2.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="22">
            <Grid Margin="0,0,0,4">
                <TextBlock Text="小岛设置" FontFamily="Comic Sans MS" FontSize="16" FontWeight="Bold"
                           Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
                <TextBlock x:Name="CloseButton" Text="&#x2715;" FontFamily="Comic Sans MS" FontSize="13" Cursor="Hand"
                           HorizontalAlignment="Right"
                           Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                           MouseLeftButtonUp="Close_Click"/>
            </Grid>
            <TextBlock Text="选择小岛展示的本地资源信息" FontFamily="Comic Sans MS"
                       Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"
                       FontSize="11" Margin="0,4,0,10"/>

            <CheckBox Content="WiFi（网络名 + 信号强度）" Style="{StaticResource ComicCheck}"
                      IsChecked="{Binding ShowWifi}"/>
            <CheckBox Content="电池（电量 + 充电状态）" Style="{StaticResource ComicCheck}"
                      IsChecked="{Binding ShowBattery}"/>
            <CheckBox Content="CPU 占用" Style="{StaticResource ComicCheck}"
                      IsChecked="{Binding ShowCpu}"/>
            <CheckBox Content="内存占用" Style="{StaticResource ComicCheck}"
                      IsChecked="{Binding ShowMemory}"/>
            <CheckBox Content="时钟" Style="{StaticResource ComicCheck}"
                      IsChecked="{Binding ShowClock}"/>

            <Border Height="1" Margin="0,14"
                    Background="{Binding Line, Source={x:Static local:ComicTheme.Current}}"/>

            <TextBlock Text="主题" FontFamily="Comic Sans MS"
                       Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"
                       FontSize="11" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="浅色（默认）" GroupName="theme" Style="{StaticResource ComicRadio}"
                             IsChecked="{Binding DarkTheme, Converter={StaticResource InverseBool}}"/>
                <RadioButton Content="深色" GroupName="theme" Style="{StaticResource ComicRadio}" Margin="16,0,0,0"
                             IsChecked="{Binding DarkTheme}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
