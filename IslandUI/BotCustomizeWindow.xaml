<Window x:Class="IslandUI.BotCustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bots="clr-namespace:IslandUI.Bots"
        xmlns:local="clr-namespace:IslandUI"
        Title="自定义外观" Width="420" Height="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">

    <Border CornerRadius="16,18,16,14"
            Background="{Binding Canvas, Source={x:Static local:ComicTheme.Current}}"
            BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"
            BorderThickness="2.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="自定义外观" FontFamily="Comic Sans MS" FontSize="16" FontWeight="Bold"
                           Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
                <TextBlock Text="&#x2715;" FontFamily="Comic Sans MS" FontSize="13" Cursor="Hand"
                           HorizontalAlignment="Right"
                           Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                           MouseLeftButtonUp="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 实时预览 -->
                <Border Grid.Column="0" Width="110" Height="110" CornerRadius="55"
                        VerticalAlignment="Top" Margin="0,4,0,0"
                        Background="{Binding CardSoft, Source={x:Static local:ComicTheme.Current}}"
                        BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"
                        BorderThickness="1.8">
                    <bots:BotView x:Name="Preview" Margin="10" Liveliness="True"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="形态" FontFamily="Comic Sans MS" FontSize="11"
                               Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
                    <WrapPanel x:Name="ShapeRow" Margin="0,4,0,10"/>

                    <TextBlock Text="颜色" FontFamily="Comic Sans MS" FontSize="11"
                               Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
                    <WrapPanel x:Name="ColorRow" Margin="0,4,0,10"/>

                    <TextBlock Text="表情" FontFamily="Comic Sans MS" FontSize="11"
                               Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
                    <WrapPanel x:Name="ExpressionRow" Margin="0,4,0,10"/>

                    <Button Content="完成" Click="Done_Click" Margin="0,8,0,0"
                            Padding="16,7" HorizontalAlignment="Left" Cursor="Hand"
                            FontFamily="Comic Sans MS"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
