<Window x:Class="IslandUI.SparkConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IslandUI"
        Title="连接 DGX Spark" Width="440" Height="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" Topmost="True">
    <Window.Resources>
        <Style x:Key="ComicInput" TargetType="TextBox">
            <Setter Property="Background" Value="{Binding Card, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="Foreground" Value="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="BorderBrush" Value="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="BorderThickness" Value="1.6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ComicPassword" TargetType="PasswordBox">
            <Setter Property="Background" Value="{Binding Card, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="Foreground" Value="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="BorderBrush" Value="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"/>
            <Setter Property="BorderThickness" Value="1.6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16,18,16,14"
            Background="{Binding Canvas, Source={x:Static local:ComicTheme.Current}}"
            BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"
            BorderThickness="2.2" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <DockPanel Margin="22">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="连接 DGX Spark" FontFamily="Comic Sans MS" FontSize="16" FontWeight="Bold"
                           Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
                <TextBlock Text="&#x2715;" FontFamily="Comic Sans MS" FontSize="13" Cursor="Hand"
                           HorizontalAlignment="Right"
                           Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                           MouseLeftButtonUp="Close_Click"/>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="通过 SSH 登录你的 Spark，自动配对 Bot 并保持一条只在本机可见的隧道。密码只用一次，不会保存。"/>

            <!-- 表单 -->
            <Grid x:Name="Form" DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="地址（用户名@主机）" Style="{StaticResource Label}"/>
                <TextBox x:Name="AddressBox" Grid.Row="1" Style="{StaticResource ComicInput}" Text="user1@"/>
                <TextBlock Text="端口" Grid.Column="2" Style="{StaticResource Label}"/>
                <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource ComicInput}" Text="22"/>
                <TextBlock x:Name="PasswordLabel" Grid.Row="2" Text="密码（仅首次连接）" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                <PasswordBox x:Name="PasswordBox" Grid.Row="3" Style="{StaticResource ComicPassword}"
                             KeyDown="PasswordBox_KeyDown"/>
                <Button x:Name="ConnectButton" Grid.Row="3" Grid.Column="2" Content="连接" Click="Connect_Click"
                        Margin="0,2" Cursor="Hand" FontFamily="Comic Sans MS" FontWeight="Bold"/>
            </Grid>

            <!-- 步骤 -->
            <Border DockPanel.Dock="Top" Margin="0,14,0,0" Padding="12,8" CornerRadius="12,14,12,10"
                    Background="{Binding Card, Source={x:Static local:ComicTheme.Current}}"
                    BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"
                    BorderThickness="1.6">
                <StackPanel x:Name="StepList"/>
            </Border>

            <!-- 需要安装 / 完成 -->
            <StackPanel x:Name="ActionRow" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                <Button x:Name="InstallButton" Content="在 Spark 上安装" Click="Install_Click" Margin="0,0,8,0"
                        Padding="12,6" Cursor="Hand" FontFamily="Comic Sans MS" Visibility="Collapsed"/>
                <Button x:Name="DoneButton" Content="完成" Click="Done_Click"
                        Padding="14,6" Cursor="Hand" FontFamily="Comic Sans MS" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="Message" DockPanel.Dock="Top" FontFamily="Comic Sans MS" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                       Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>

            <TextBlock DockPanel.Dock="Top" Text="日志" Style="{StaticResource Label}" Margin="0,10,0,2"/>
            <Border CornerRadius="10" BorderThickness="1.6"
                    Background="{Binding CardSoft, Source={x:Static local:ComicTheme.Current}}"
                    BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}">
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         Background="Transparent" Padding="8,6" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                         VerticalScrollBarVisibility="Auto"
                         Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
