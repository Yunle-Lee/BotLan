<Window x:Class="IslandUI.SmallIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IslandUI.Controls"
        xmlns:local="clr-namespace:IslandUI"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="240" Height="270"
        Title="IslandUI">

    <Grid x:Name="PillArea" HorizontalAlignment="Center" VerticalAlignment="Top"
          Margin="0,14,0,0" Background="Transparent"
          MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
          MouseLeftButtonDown="Pill_MouseLeftButtonDown"
          MouseMove="Pill_MouseMove"
          MouseLeftButtonUp="Pill_MouseLeftButtonUp">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="设置" Click="SettingsMenuItem_Click"/>
                <MenuItem Header="切换到长岛（Agents）" Click="SwitchToLong_Click"/>
                <Separator/>
                <MenuItem Header="退出" Click="ExitMenuItem_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- 可见胶囊(阴影特效只挂在这里,不会裁剪旋钮) -->
        <Border x:Name="Pill" Width="64" Height="190"
                CornerRadius="30,34,32,28"
                Background="{Binding Canvas, Source={x:Static local:ComicTheme.Current}}"
                BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"
                BorderThickness="2.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.18" Color="Black"/>
            </Border.Effect>
        </Border>

        <!-- 内容叠层(宽度锁死到胶囊,否则会把 PillArea 撑宽、滑块跑偏) -->
        <Grid Width="{Binding ActualWidth, ElementName=Pill}">
            <StackPanel VerticalAlignment="Center" Margin="0,10" IsHitTestVisible="False">
                <TextBlock x:Name="ClockText" Text="9:41" FontFamily="Comic Sans MS"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                           HorizontalAlignment="Center"/>

                <!-- 唯一图标:融合态 ↔ 展开态原地形变(WIFIBattery.mp4) -->
                <controls:FusionIcon x:Name="Icon" Width="54" Height="54" Fusion="1"
                                     Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                                     Margin="0,8"/>

                <TextBlock x:Name="ValuesText" Opacity="0" FontFamily="Comic Sans MS"
                           FontSize="11" TextAlignment="Center"
                           Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border x:Name="GearButton" Width="32" Height="32" CornerRadius="16"
                    Background="{Binding Card, Source={x:Static local:ComicTheme.Current}}"
                    BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}"
                    BorderThickness="2" ToolTip="设置"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                    Cursor="Hand"
                    MouseLeftButtonUp="Gear_Click">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- 右上角明暗滑块:轨道贴着胶囊圆角边框线,旋钮骑在边框上(不被裁剪) -->
        <controls:ThemeSlider Width="64" Height="64"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Value="{Binding ThemeValue, Source={x:Static local:IslandSettings.Instance}, Mode=TwoWay}"/>
    </Grid>
</Window>
