<Window x:Class="IslandUI.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bots="clr-namespace:IslandUI.Bots"
        xmlns:local="clr-namespace:IslandUI"
        Title="Chat" Width="1036" Height="800" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" Topmost="True">

    <Window.Resources>
        <local:UserToBubbleBrushConverter x:Key="UserToBubbleBrush"/>
        <local:UserToBubbleRadiusConverter x:Key="UserToBubbleRadius"/>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Viewbox x:Name="DesignViewbox" Stretch="Uniform" StretchDirection="DownOnly"
                 SizeChanged="StudioDesign_SizeChanged">
            <Canvas x:Name="DesignCanvas" Width="1036" Height="800">
                <!-- Only this fixed upper-right arc is visible and owns wheel input. -->
                <Canvas x:Name="OrbitLayer" Width="1036" Height="800"
                        PreviewMouseWheel="Orbit_MouseWheel">
                    <Path x:Name="OrbitWheelSurface" Fill="#01000000" Stretch="None"/>
                    <Canvas x:Name="OrbitFadeLeading" Width="1036" Height="800">
                        <Canvas x:Name="OrbitItems" Width="1036" Height="800"/>
                    </Canvas>
                </Canvas>

                <!-- Shadow only: never rasterize the browser/text through an ancestor effect. -->
                <Border x:Name="ChatShadow" Canvas.Left="{Binding (Canvas.Left), ElementName=ChatCard}"
                        Canvas.Top="{Binding (Canvas.Top), ElementName=ChatCard}"
                        Width="{Binding Width, ElementName=ChatCard}" Height="{Binding Height, ElementName=ChatCard}"
                        CornerRadius="{Binding CornerRadius, ElementName=ChatCard}"
                        Background="{Binding Card, Source={x:Static local:ComicTheme.Current}}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.14" Color="#111111"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="ChatCard" Canvas.Left="185" Canvas.Top="140"
                        Width="716" Height="540" CornerRadius="44"
                        Background="{Binding Card, Source={x:Static local:ComicTheme.Current}}"
                        BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}" BorderThickness="6">
                    <Grid>
                    <Grid x:Name="LegacyChatContent" Margin="25,22,25,21" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="66"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="80"/>
                        </Grid.RowDefinitions>

                        <!-- Selected Bot identity -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Width="62" Height="62" CornerRadius="31"
                                        Background="{Binding SkyTint, Source={x:Static local:ComicTheme.Current}}"
                                        BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}" BorderThickness="2">
                                    <bots:BotView x:Name="HeaderBot" Margin="4"/>
                                </Border>
                                <StackPanel Margin="12,5,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
                                    <TextBlock x:Name="StatusText" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"
                                               Text="随时准备着"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Width="36" Height="36" CornerRadius="18" BorderThickness="2.5"
                                    BorderBrush="#CF3838" Background="White" Cursor="Hand"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-18,0,0"
                                    MouseLeftButtonUp="Close_Click">
                                <TextBlock Text="&#x2715;" FontSize="23" FontWeight="Light"
                                           Foreground="#CF3838" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                        </Grid>

                        <!-- Empty state is the large centered title in the reference. -->
                        <Grid Grid.Row="1" Grid.RowSpan="1">
                            <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <ItemsControl x:Name="Messages">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="16,13" Margin="0,3"
                                                        HorizontalAlignment="{Binding Align}"
                                                        Background="{Binding FromUser, Converter={StaticResource UserToBubbleBrush}}"
                                                        CornerRadius="{Binding FromUser, Converter={StaticResource UserToBubbleRadius}}"
                                                        MaxWidth="430">
                                                    <TextBlock Text="{Binding Text}" FontSize="15"
                                                               Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                                                               TextWrapping="Wrap" LineHeight="24"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border x:Name="ThinkingPill" HorizontalAlignment="Left"
                                            CornerRadius="28,28,28,7" Padding="19,12" Margin="0,3"
                                            Background="{Binding CardSoft, Source={x:Static local:ComicTheme.Current}}"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ThinkDot1" Width="8" Height="8" Margin="3,0"
                                                     Fill="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
                                            <Ellipse x:Name="ThinkDot2" Width="8" Height="8" Margin="3,0"
                                                     Fill="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
                                            <Ellipse x:Name="ThinkDot3" Width="8" Height="8" Margin="3,0"
                                                     Fill="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock x:Name="ChatEmptyState" Text="Chat Window"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Comic Sans MS" FontSize="58" FontWeight="Bold"
                                       Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Bottom composer -->
                        <Border Grid.Row="2" Margin="36,8,30,0" CornerRadius="40"
                                Background="{Binding Card, Source={x:Static local:ComicTheme.Current}}"
                                BorderBrush="{Binding ComposerLine, Source={x:Static local:ComicTheme.Current}}"
                                BorderThickness="2" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InputBox" Grid.Column="0"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                                         CaretBrush="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                                         FontSize="16" Padding="10,7" VerticalContentAlignment="Center"
                                         KeyDown="Input_KeyDown" AcceptsReturn="False"/>
                                <Border x:Name="SendButton" Grid.Column="1" Width="52" Height="52"
                                        CornerRadius="26" Cursor="Hand"
                                        Background="{Binding Blue, Source={x:Static local:ComicTheme.Current}}"
                                        MouseLeftButtonUp="Send_Click">
                                    <TextBlock Text="&#x2191;" FontSize="23"
                                               Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>
                </Border>
            </Canvas>
        </Viewbox>
        <!-- Native-size page, outside the scaled illustration/rail. Bounds follow ChatCard. -->
        <Canvas x:Name="StudioOverlay" UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Border x:Name="FoldCapsule" Visibility="Collapsed" IsHitTestVisible="False"
                            Background="{Binding Card, Source={x:Static local:ComicTheme.Current}}"
                            BorderBrush="{Binding Outline, Source={x:Static local:ComicTheme.Current}}" BorderThickness="2.2">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.14"/></Border.Effect>
                    </Border>
                    <Grid x:Name="StudioShell" Canvas.Left="199" Canvas.Top="154" Width="688" Height="512"
                          TextOptions.TextFormattingMode="Display">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="StudioHeaderRow" Height="32"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="StudioDragBar" Background="Transparent" CornerRadius="28,28,0,0"
                                MouseLeftButtonDown="StudioDragBar_MouseLeftButtonDown" Cursor="SizeAll">
                            <Grid Margin="20,0,16,0">
                                <TextBlock x:Name="StudioCaption" Text="{Binding Text, ElementName=TitleText}" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"/>
                                <TextBlock x:Name="StudioDragHint" Text="拖动窗口" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="10" Foreground="{Binding Muted, Source={x:Static local:ComicTheme.Current}}"
                                           IsHitTestVisible="False"/>
                                <Button x:Name="StudioCloseButton" Content="✕" HorizontalAlignment="Right" Width="26" Height="26"
                                        Background="Transparent" Foreground="#CF3838" BorderThickness="0"
                                        Cursor="Hand" Click="StudioClose_Click" ToolTip="折叠 Chat"/>
                            </Grid>
                        </Border>
                        <Grid x:Name="StudioViewport" Grid.Row="1" SizeChanged="StudioViewport_SizeChanged">
                            <Grid x:Name="StudioWebHost"/>
                            <Canvas x:Name="StudioAvatarLayer" IsHitTestVisible="False" ClipToBounds="True">
                                <bots:BotView x:Name="StudioBotAvatar" Visibility="Collapsed" Liveliness="True"
                                              GazeYaw="-12" GazePitch="4"/>
                            </Canvas>
                            <Border x:Name="StudioLoading" Background="{Binding Card, Source={x:Static local:ComicTheme.Current}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24">
                                    <TextBlock x:Name="StudioLoadMessage" Text="正在打开 AI Studio…" FontSize="16" TextWrapping="Wrap"
                                               TextAlignment="Center" Foreground="{Binding Ink, Source={x:Static local:ComicTheme.Current}}"/>
                                    <Button x:Name="StudioRetry" Content="重新连接" Margin="0,16,0,0" Padding="16,8"
                                            Visibility="Collapsed" Click="StudioRetry_Click"/>
                                    <Button x:Name="StudioFallback" Content="暂用原对话窗口" Margin="0,8,0,0" Padding="16,8"
                                            Visibility="Collapsed" Click="StudioFallback_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
        </Canvas>
        <Canvas x:Name="FoldLayer" IsHitTestVisible="False"/>
    </Grid>
</Window>
